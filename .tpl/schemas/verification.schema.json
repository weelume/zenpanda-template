{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:git-template:verification:0.2.0",
  "title": "源码绑定的真实验收记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "formatVersion",
    "status",
    "checkedAt",
    "sourceCommit",
    "sourceDigest",
    "environment",
    "checks",
    "services",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/verification.schema.json"
    },
    "format": {
      "const": "git-template-verification"
    },
    "formatVersion": {
      "const": "0.2.0"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "arch",
        "node",
        "packageManager",
        "cleanDirectory",
        "localGitClone"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": "string",
          "minLength": 1
        },
        "cleanDirectory": {
          "type": "boolean"
        },
        "localGitClone": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cwd",
          "argv",
          "status",
          "exitCode",
          "startedAt",
          "finishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-executed"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "stopped",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-executed"
            ]
          },
          "stopped": {
            "type": "boolean"
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
